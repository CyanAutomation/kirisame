{
  "name": "@cyanautomation/kirisame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contract-validated Cloudflare Worker foundation for Kirisame publication.",
  "scripts": {
    "generate:contracts": "node scripts/generate-contract-validators.mjs",
    "pretest:contracts": "npm run generate:contracts",
    "test:contracts": "node --import tsx --test tests/contracts/contract.test.mjs",
    "pretest:worker": "npm run generate:contracts",
    "test:worker": "vitest run --coverage",
    "health": "npm run test:worker && npx fallow health --hotspots --targets --coverage coverage/coverage-final.json",
    "test": "npm run test:contracts && npm run test:worker",
    "prebuild": "npm run generate:contracts",
    "build": "node scripts/run-cf.mjs build",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "predev": "npm run generate:contracts",
    "dev": "node scripts/run-cf.mjs dev",
    "deploy": "node scripts/run-cf.mjs deploy"
  },
  "dependencies": {
    "canonicalize": "2.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1",
    "cf": "1.0.0-rc.1",
    "eslint": "^10.15.0",
    "fallow": "^3.47.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
